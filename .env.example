# Copy to .env (already gitignored) and fill in what you need.
# docker-compose.yml reads this file automatically and substitutes ${VARS}.
# DATABASE_URL and FRONTEND_ORIGIN are set inside docker-compose.yml itself —
# no need to set them here for the containerized stack.

# Optional: require X-API-Key on every request. Unset = no auth (local dev default).
API_KEY=

# Only needed to run `docker compose run --rm poller` (Gmail ingestion).
# See README.md "Gmail ingestion" for how to generate an App Password.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
